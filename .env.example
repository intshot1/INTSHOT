# Configuración del servidor
PORT=

# Conexión a la base de datos (MongoDB)
MONGODB_URI=

# Envio de correos con nodemailer (Gmail)
# GMAIL_USER: la cuenta de Gmail desde la que salen los correos.
# GPASS: NO es la contrasena normal de la cuenta. Es una "contrasena de
# aplicacion" de 16 caracteres que se genera en:
# Cuenta de Google > Seguridad > Verificacion en 2 pasos > Contrasenas de aplicaciones
GMAIL_USER=
GPASS=

# Respaldo de la base de datos: correo que lo recibe y ruta de mongodump
# (MONGODUMP_PATH solo hace falta si mongodump no esta en el PATH).
BACKUP_EMAIL=
MONGODUMP_PATH=
