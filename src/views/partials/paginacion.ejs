<%#
    Paginacion reutilizable. Necesita:
    - pagina y totalPaginas: la pagina actual y cuantas hay.
    - total: cuantos registros hay en total.
    - filtros: el resto de la URL (?buscar=...&categoria=...) para no perder
      la busqueda al cambiar de pagina.
%>
<% if (totalPaginas > 1) { %>
<nav class="mt-3">
    <ul class="pagination justify-content-center">

        <% if (pagina > 1) { %>
            <li class="page-item"><a class="page-link" href="?pagina=<%= pagina - 1 %>&<%= filtros %>">Anterior</a></li>
        <% } else { %>
            <li class="page-item disabled"><span class="page-link">Anterior</span></li>
        <% } %>

        <% for (var numero = 1; numero <= totalPaginas; numero++) { %>
            <% if (numero === pagina) { %>
                <li class="page-item active"><span class="page-link"><%= numero %></span></li>
            <% } else { %>
                <li class="page-item"><a class="page-link" href="?pagina=<%= numero %>&<%= filtros %>"><%= numero %></a></li>
            <% } %>
        <% } %>

        <% if (pagina < totalPaginas) { %>
            <li class="page-item"><a class="page-link" href="?pagina=<%= pagina + 1 %>&<%= filtros %>">Siguiente</a></li>
        <% } else { %>
            <li class="page-item disabled"><span class="page-link">Siguiente</span></li>
        <% } %>

    </ul>

    <p class="text-center text-muted small">
        Página <%= pagina %> de <%= totalPaginas %> &middot; <%= total %> registros
    </p>
</nav>
<% } %>
