<!-- Aplica el tema guardado (claro/oscuro) ANTES de que el navegador pinte la
     pagina, para que no se vea un parpadeo blanco al entrar en modo oscuro. -->
<script>
    (function () {
        try {
            var tema = localStorage.getItem('intshot-theme');
            var prefiereOscuro = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
            if (tema === 'dark' || (!tema && prefiereOscuro)) {
                document.documentElement.setAttribute('data-bs-theme', 'dark');
            }
        } catch (e) {}
    })();
</script>
