<!DOCTYPE html>
<html lang="es">

<head>
    <%- include('../../partials/head'); %>
</head>

<body>

    <div class="app-shell d-lg-flex">

        <%- include('../../partials/menu'); %>

        <div class="app-content-wrap flex-grow-1 d-flex flex-column">

            <%- include('../../partials/header'); %>

            <main class="app-main">

                <%- include('../../partials/notificaciones'); %>

                <div class="page-header">
                    <div>
                        <h1 class="display-4">Mi Carrito</h1>
                        <p class="text-muted small mb-0">Revisa tus productos antes de confirmar el pedido.</p>
                    </div>
                </div>

                <%
                    // Se descartan las lineas cuyo producto ya fue eliminado del inventario.
                    var lista = (typeof carrito !== "undefined") ? carrito.filter(function(item) { return item.producto; }) : [];
                    var total = 0;
                %>

                <% if (lista.length > 0) { %>
                <div class="row g-4">

                    <!-- Lista de productos del carrito -->
                    <div class="col-lg-8">
                        <div class="carrito-lista">
                            <% lista.forEach(function(item) { %>
                                <% var subtotal = item.cantidad * Number(item.producto.precio.toString()); %>
                                <% total = total + subtotal; %>
                                <div class="carrito-item">

                                    <div class="carrito-item-imagen">
                                        <% if (item.producto.imagen) { %>
                                            <img src="<%= item.producto.imagen %>" alt="<%= item.producto.nombre %>">
                                        <% } else { %>
                                            <img src="/img/Logo-INTSHOT.jpg" alt="Sin imagen" style="opacity:.35;">
                                        <% } %>
                                    </div>

                                    <div class="carrito-item-info">
                                        <p class="carrito-item-nombre"><%= item.producto.nombre %></p>
                                        <p class="carrito-item-meta">
                                            <%= item.producto.color %> &middot; Talla <%= item.producto.talla %>
                                        </p>
                                        <p class="carrito-item-precio-unitario"><%= pesos(item.producto.precio) %> c/u</p>

                                        <button type="button" class="carrito-item-eliminar"
                                            onclick="modal_eliminar('Carrito', 'Está seguro de eliminar <strong><%= item.producto.nombre %></strong> del carrito?', '/carritos/<%= item._id %>')"
                                            data-bs-toggle="modal" data-bs-target="#confirmacion">
                                            <span class="material-symbols-outlined">delete</span>
                                            Eliminar
                                        </button>
                                    </div>

                                    <!-- Cambiar la cantidad (PUT con method-override) -->
                                    <form action="/carritos/<%= item._id %>?_method=PUT" method="post" class="carrito-item-cantidad">
                                        <div class="cantidad-stepper">
                                            <button type="button" class="cantidad-btn" onclick="cambiar_cantidad(this, -1)" aria-label="Quitar una unidad">−</button>
                                            <input type="number" name="cantidad" value="<%= item.cantidad %>" min="1" max="<%= item.producto.stock %>"
                                                class="cantidad-input" aria-label="Cantidad de <%= item.producto.nombre %>">
                                            <button type="button" class="cantidad-btn" onclick="cambiar_cantidad(this, 1)" aria-label="Agregar una unidad">+</button>
                                        </div>
                                        <button type="submit" class="btn btn-sm btn-outline-secondary w-100 mt-2">Actualizar</button>
                                    </form>

                                    <div class="carrito-item-subtotal">
                                        <span class="carrito-item-subtotal-label">Subtotal</span>
                                        <span class="carrito-item-subtotal-valor"><%= pesos(subtotal) %></span>
                                    </div>

                                </div>
                            <% }); %>
                        </div>

                        <a href="/catalogo" class="btn btn-outline-secondary mt-3">
                            <span class="material-symbols-outlined" style="font-size:18px; vertical-align:-4px;">arrow_back</span>
                            Seguir comprando
                        </a>
                    </div>

                    <!-- Resumen de la compra -->
                    <div class="col-lg-4">
                        <div class="resumen-compra">
                            <h2 class="resumen-compra-title">Resumen de compra</h2>

                            <div class="resumen-compra-fila">
                                <span>Productos</span>
                                <span><%= lista.length %></span>
                            </div>

                            <div class="resumen-compra-fila">
                                <span>Subtotal</span>
                                <span><%= pesos(total) %></span>
                            </div>

                            <hr>

                            <div class="resumen-compra-fila resumen-compra-total">
                                <span>Total</span>
                                <span><%= pesos(total) %></span>
                            </div>

                            <a href="/pedidos/formulario" class="btn btn-success w-100 mt-3">
                                <span class="material-symbols-outlined" style="font-size:18px; vertical-align:-4px;">task_alt</span>
                                Confirmar Pedido
                            </a>
                        </div>
                    </div>

                </div>

                <% } else { %>
                    <div class="carrito-vacio">
                        <span class="material-symbols-outlined">shopping_cart</span>
                        <p class="fs-5 text-muted mt-2">Tu carrito está vacío.</p>
                        <a href="/catalogo" class="btn btn-primary">Ver catálogo</a>
                    </div>
                <% } %>

            </main>

            <%- include('../../partials/footer'); %>

        </div>
    </div>

    <%- include('../../partials/scripts'); %>

    <script>
        // Sube o baja la cantidad del producto sin pasarse del stock disponible.
        function cambiar_cantidad(boton, cambio) {
            var campo = boton.parentElement.querySelector('.cantidad-input');
            var minimo = parseInt(campo.min, 10) || 1;
            var maximo = parseInt(campo.max, 10);
            var valor = parseInt(campo.value, 10);

            if (isNaN(valor)) {
                valor = minimo;
            }

            valor = valor + cambio;

            if (valor < minimo) {
                valor = minimo;
            }
            if (!isNaN(maximo) && valor > maximo) {
                valor = maximo;
            }

            campo.value = valor;
        }
    </script>
</body>

</html>
