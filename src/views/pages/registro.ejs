<!DOCTYPE html>
<html lang="es">

<head>
    <%- include('../partials/head_auth'); %>
</head>

<body style="background-color: var(--intshot-bg, #f8fafc);">

    <div class="container">
        <%- include('../partials/notificaciones'); %>

        <div class="auth-page">
            <div class="auth-card">

                <div class="auth-card-header">
                    <img src="/img/logo-intshot-icon.png" alt="INTSHOT" class="auth-logo-img" style="width:64px; height:64px; object-fit:contain;">
                    <h1 class="auth-title">INTSHOT</h1>
                    <p class="auth-subtitle">Crea tu cuenta para comenzar a gestionar tu inventario.</p>
                </div>

                <form action="/registro" method="post">

                    <div class="row">
                        <div class="col-md-6 auth-field">
                            <label class="form-label" for="nombre">Nombre</label>
                            <div class="input-icon-group">
                                <span class="material-symbols-outlined">person</span>
                                <input type="text" id="nombre" class="form-control" name="nombre" placeholder="Ej: Juan" required>
                            </div>
                        </div>
                        <div class="col-md-6 auth-field">
                            <label class="form-label" for="apellido">Apellido</label>
                            <div class="input-icon-group">
                                <span class="material-symbols-outlined">badge</span>
                                <input type="text" id="apellido" class="form-control" name="apellido" placeholder="Ej: Pérez" required>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 auth-field">
                            <label class="form-label" for="correo">Correo electrónico</label>
                            <div class="input-icon-group">
                                <span class="material-symbols-outlined">mail</span>
                                <input type="email" id="correo" class="form-control" name="correo" placeholder="correo@ejemplo.com" required>
                            </div>
                        </div>
                        <div class="col-md-6 auth-field">
                            <label class="form-label" for="telefono">Teléfono</label>
                            <div class="input-icon-group">
                                <span class="material-symbols-outlined">call</span>
                                <input type="text" id="telefono" class="form-control" name="telefono" placeholder="3001234567" required>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 auth-field">
                            <label class="form-label" for="password">Contraseña</label>
                            <div class="input-icon-group">
                                <span class="material-symbols-outlined">lock</span>
                                <input type="password" id="password" class="form-control" name="password" placeholder="········" required>
                                <button type="button" class="toggle-password" data-target="password" aria-label="Mostrar contraseña">
                                    <span class="material-symbols-outlined">visibility</span>
                                </button>
                            </div>
                        </div>
                        <div class="col-md-6 auth-field">
                            <label class="form-label" for="veri_password">Confirmar contraseña</label>
                            <div class="input-icon-group">
                                <span class="material-symbols-outlined">lock</span>
                                <input type="password" id="veri_password" class="form-control" name="veri_password" placeholder="········" required>
                                <button type="button" class="toggle-password" data-target="veri_password" aria-label="Mostrar contraseña">
                                    <span class="material-symbols-outlined">visibility</span>
                                </button>
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-auth mt-2">Registrarse</button>

                    <p class="auth-footer">
                        ¿Ya tienes cuenta? <a href="/login">Iniciar sesión</a>
                    </p>
                </form>
            </div>
        </div>
    </div>

    <script src="/js/bootstrap.bundle.min.js"></script>
    <script src="/js/librerias.js"></script>
</body>

</html>
