<!DOCTYPE html>
<html lang="es">

<head>
    <%- include('../partials/head'); %>
</head>

<body style="background-color: #f8fafc;">

    <div class="container">
        <%- include('../partials/notificaciones'); %>

        <section class="h-100 gradient-form" style="background-color: #f8fafc;">
            <div class="container py-5 h-100">
                <div class="row d-flex justify-content-center align-items-center h-100">
                    <div class="col-xl-10">
                        <div class="card rounded-3 text-black" style="overflow:hidden;">
                            <div class="row g-0">

                                <div class="col-lg-6">
                                    <div class="card-body p-md-5 mx-md-4">

                                        <div class="text-center">
                                            <img src="/img/Logo-INTSHOT.jpg" style="width: 120px; border-radius:12px;" alt="logo">
                                            <h4 class="mt-3 mb-5 pb-1" style="color:#003d9b; font-weight:800;">INTSHOT</h4>
                                        </div>

                                        <h4 class="mb-4" style="color:#003d9b;">Bienvenido a INTSHOT</h4>
                                        <p class="small mb-0">INTSHOT es un sistema inteligente diseñado para la gestión y
                                            control de inventarios de prendas y materiales, permitiendo a las empresas
                                            administrar sus recursos de forma rápida, organizada y segura.
                                            <br>
                                            Nuestra plataforma facilita el seguimiento de productos, mejora la toma de
                                            decisiones y reduce errores operativos mediante herramientas digitales modernas.</p>

                                        <div class="d-flex align-items-center pt-4">
                                            <a class="mb-0 me-2" href="/login">Ya tengo cuenta</a>
                                        </div>

                                    </div>
                                </div>

                                <div class="col-lg-6 d-flex align-items-center gradient-custom-2">
                                    <div class="text-white px-3 py-4 p-md-5 mx-md-4 w-100">

                                        <form action="/registro" method="post">
                                            <h1>Registro</h1>
                                            <br>

                                            <div class="mb-4">
                                                <label class="form-label" for="nombre">Nombre</label>
                                                <input type="text" id="nombre" class="form-control" name="nombre" placeholder="Digite su nombre">
                                            </div>

                                            <div class="mb-4">
                                                <label class="form-label" for="apellido">Apellido</label>
                                                <input type="text" id="apellido" class="form-control" name="apellido" placeholder="Digite su apellido">
                                            </div>

                                            <div class="mb-4">
                                                <label class="form-label" for="telefono">Teléfono</label>
                                                <input type="text" id="telefono" class="form-control" name="telefono" placeholder="Digite su teléfono">
                                            </div>

                                            <div class="mb-4">
                                                <label class="form-label" for="correo">Correo</label>
                                                <input type="email" id="correo" class="form-control" name="correo" placeholder="Digite su correo">
                                            </div>

                                            <div class="mb-4">
                                                <label class="form-label" for="password">Contraseña</label>
                                                <input type="password" id="password" class="form-control" name="password" placeholder="Digite su contraseña">
                                            </div>

                                            <div class="mb-4">
                                                <label class="form-label" for="veri_password">Repita su Contraseña</label>
                                                <input type="password" id="veri_password" class="form-control" name="veri_password" placeholder="Repita su contraseña">
                                            </div>

                                            <div class="text-center pt-1 mb-5 pb-1">
                                                <button class="btn btn-primary btn-block fa-lg mb-3" type="submit">Registrarse</button>
                                            </div>
                                        </form>

                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <%- include('../partials/scripts'); %>
</body>

</html>
