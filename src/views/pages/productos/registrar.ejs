<!DOCTYPE html>
<html lang="es">

<head>
    <%- include('../../partials/head'); %>
</head>

<body>

    <div class="app-shell d-lg-flex">

        <%- include('../../partials/menu'); %>

        <div class="app-content-wrap flex-grow-1 d-flex flex-column">

            <%- include('../../partials/header'); %>

            <main class="app-main">

                <%- include('../../partials/notificaciones'); %>

                <div class="container-lg py-3">
                    <div class="card shadow-sm">
                        <div class="card-body p-4">

                            <h1 class="display-4">Crear Producto</h1>
                            <p class="text-muted mb-4">Ingrese la información básica del producto.</p>

                            <form action="/productos" method="post">

                                <div class="row g-3">

                                    <!-- Columna Izquierda -->
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label class="form-label" for="nombre">Nombre del Producto</label>
                                            <input type="text" class="form-control" id="nombre" name="nombre" placeholder="Nombre del producto" required>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label" for="color">Color</label>
                                            <input type="text" class="form-control" id="color" name="color" placeholder="Color del producto">
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label" for="descripcion">Descripción</label>
                                            <input type="text" class="form-control" id="descripcion" name="descripcion" placeholder="Descripción del producto">
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label" for="imagen">Imagen del producto (url)</label>
                                            <input type="text" class="form-control" id="imagen" name="imagen" placeholder="/img/mi-producto.jpg">
                                            <small class="text-muted d-block mt-1">Si no escribe una imagen, se mostrará una imagen predeterminada en el catálogo.</small>
                                        </div>
                                    </div>

                                    <!-- Columna Derecha -->
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label class="form-label" for="categoria">Categoría</label>
                                            <select name="categoria" class="form-select" id="categoria" required>
                                                <option value="">Seleccione la Categoría</option>
                                                <option value="Camisetas">Camisetas</option>
                                                <option value="Pantalones">Pantalones</option>
                                                <option value="Chaquetas">Chaquetas</option>
                                                <option value="Accesorios">Accesorios</option>
                                                <option value="Insumos">Insumos</option>
                                                <option value="Otros">Otros</option>
                                            </select>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label" for="talla">Talla</label>
                                            <input type="text" class="form-control" id="talla" name="talla" placeholder="Talla del producto">
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label" for="stock">Stock disponible</label>
                                            <input type="number" min="0" max="999" class="form-control" id="stock" name="stock" placeholder="Stock del producto" required>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label" for="precio">Precio</label>
                                            <input type="number" min="0" class="form-control" id="precio" name="precio" placeholder="Precio del producto" required>
                                        </div>
                                    </div>

                                    <!-- Botones -->
                                    <div class="col-12 mt-4 text-center">
                                        <button type="submit" class="btn btn-success px-5">Guardar</button>
                                        <a href="/productos" class="btn btn-outline-secondary px-5">Volver</a>
                                    </div>

                                </div>
                            </form>

                        </div>
                    </div>
                </div>

            </main>

            <%- include('../../partials/footer'); %>

        </div>
    </div>

    <%- include('../../partials/scripts'); %>
</body>

</html>
