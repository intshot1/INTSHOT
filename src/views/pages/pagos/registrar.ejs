<!DOCTYPE html>
<html lang="es">

<head>
    <%- include('../../partials/head'); %>
</head>

<body>

    <div class="app-shell d-lg-flex">

        <%- include('../../partials/menu'); %>

        <div class="app-content-wrap flex-grow-1 d-flex flex-column">

            <%- include('../../partials/header'); %>

            <main class="app-main">

                <%- include('../../partials/notificaciones'); %>

                <div class="container-lg py-3">
                    <div class="card shadow-sm">
                        <div class="card-body p-4">

                            <h1 class="display-4">Registrar Pago</h1>
                            <p class="text-muted mb-4">Seleccione el pedido y el método de pago.</p>

                            <form action="/pagos" method="post">

                                <div class="row g-3">

                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label class="form-label" for="pedido">Pedido</label>
                                            <% if (typeof pedidos !== "undefined") { %>
                                                <select name="pedido" class="form-select" id="pedido" required>
                                                    <option value="">Seleccione el pedido</option>
                                                    <% pedidos.forEach(function(pedido) { %>
                                                        <option value="<%=pedido._id%>"><%=pedido._id%> - <%=pedido.estado%></option>
                                                    <% }); %>
                                                </select>
                                            <% } else { %>
                                                <input type="text" class="form-control" id="pedido" name="pedido" placeholder="Id del pedido" required>
                                            <% } %>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label class="form-label" for="metodo">Método de pago</label>
                                            <select name="metodo" class="form-select" id="metodo" required>
                                                <option value="">Seleccione...</option>
                                                <option value="Efectivo">Efectivo</option>
                                                <option value="Tarjeta">Tarjeta</option>
                                                <option value="Transferencia">Transferencia</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label class="form-label" for="valor">Valor</label>
                                            <input type="number" min="0" step="0.01" class="form-control" id="valor" name="valor" placeholder="Valor del pago" required>
                                        </div>
                                    </div>

                                    <!-- Botones -->
                                    <div class="col-12 mt-4 text-center">
                                        <button type="submit" class="btn btn-success px-5">Confirmar Pago</button>
                                        <a href="/pagos" class="btn btn-outline-secondary px-5">Volver</a>
                                    </div>

                                </div>
                            </form>

                        </div>
                    </div>
                </div>

            </main>

            <%- include('../../partials/footer'); %>

        </div>
    </div>

    <%- include('../../partials/scripts'); %>
</body>

</html>
