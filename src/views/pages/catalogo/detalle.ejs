<!DOCTYPE html>
<html lang="es">

<head>
    <%- include('../../partials/head'); %>
</head>

<body>

    <div class="app-shell d-lg-flex">

        <%- include('../../partials/menu'); %>

        <div class="app-content-wrap flex-grow-1 d-flex flex-column">

            <%- include('../../partials/header'); %>

            <main class="app-main">

                <%- include('../../partials/notificaciones'); %>

                <!-- Migas de pan: para saber siempre donde esta parado el usuario -->
                <nav class="detalle-migas">
                    <a href="/catalogo">Catálogo</a>
                    <span class="material-symbols-outlined">chevron_right</span>
                    <a href="/catalogo?categoria=<%= encodeURIComponent(producto.categoria) %>"><%= producto.categoria %></a>
                    <span class="material-symbols-outlined">chevron_right</span>
                    <span class="detalle-migas-actual"><%= producto.nombre %></span>
                </nav>

                <div class="detalle-producto">

                    <!-- Imagen grande del producto -->
                    <div class="detalle-producto-imagen">
                        <% if (producto.imagen) { %>
                            <img src="<%= producto.imagen %>" alt="<%= producto.nombre %>">
                        <% } else { %>
                            <img src="/img/Logo-INTSHOT.jpg" alt="Sin imagen" class="detalle-sin-imagen">
                        <% } %>
                    </div>

                    <!-- Toda la informacion del producto -->
                    <div class="detalle-producto-info">

                        <span class="badge producto-badge-categoria"><%= producto.categoria %></span>
                        <h1 class="detalle-producto-titulo"><%= producto.nombre %></h1>
                        <p class="detalle-producto-codigo">Código INT-<%= producto._id.toString().slice(-6).toUpperCase() %></p>

                        <p class="detalle-producto-precio"><%= pesos(producto.precio) %></p>

                        <!-- Disponibilidad: cambia de color segun el stock que quede -->
                        <% if (producto.stock === 0) { %>
                            <p class="detalle-producto-stock detalle-stock-agotado">
                                <span class="material-symbols-outlined">remove_shopping_cart</span>
                                Producto agotado por el momento
                            </p>
                        <% } else if (producto.stock <= 5) { %>
                            <p class="detalle-producto-stock detalle-stock-bajo">
                                <span class="material-symbols-outlined">warning</span>
                                ¡Quedan solo <%= producto.stock %> unidad<%= producto.stock === 1 ? "" : "es" %>!
                            </p>
                        <% } else { %>
                            <p class="detalle-producto-stock detalle-stock-disponible">
                                <span class="material-symbols-outlined">check_circle</span>
                                <%= producto.stock %> unidades disponibles
                            </p>
                        <% } %>

                        <!-- Descripcion completa -->
                        <div class="detalle-bloque">
                            <h2 class="detalle-bloque-titulo">Descripción</h2>
                            <p class="detalle-bloque-texto">
                                <%= producto.descripcion || "Este producto aún no tiene una descripción." %>
                            </p>
                        </div>

                        <!-- Ficha tecnica -->
                        <div class="detalle-bloque">
                            <h2 class="detalle-bloque-titulo">Ficha técnica</h2>
                            <div class="detalle-ficha">
                                <div class="detalle-ficha-item">
                                    <span class="detalle-ficha-label">Categoría</span>
                                    <span class="detalle-ficha-valor"><%= producto.categoria %></span>
                                </div>
                                <div class="detalle-ficha-item">
                                    <span class="detalle-ficha-label">Color</span>
                                    <span class="detalle-ficha-valor"><%= producto.color || "—" %></span>
                                </div>
                                <div class="detalle-ficha-item">
                                    <span class="detalle-ficha-label">Talla</span>
                                    <span class="detalle-ficha-valor"><%= producto.talla || "—" %></span>
                                </div>
                                <div class="detalle-ficha-item">
                                    <span class="detalle-ficha-label">Unidades en stock</span>
                                    <span class="detalle-ficha-valor"><%= producto.stock %></span>
                                </div>
                            </div>
                        </div>

                        <!-- Botones de accion -->
                        <div class="detalle-acciones">
                            <% if (producto.stock > 0) { %>
                                <a href="/carritos/agregar/<%= producto._id %>" class="btn btn-primary detalle-btn-comprar">
                                    <span class="material-symbols-outlined">add_shopping_cart</span>
                                    Agregar al carrito
                                </a>
                            <% } else { %>
                                <button type="button" class="btn btn-primary detalle-btn-comprar" disabled>
                                    <span class="material-symbols-outlined">add_shopping_cart</span>
                                    Agotado
                                </button>
                            <% } %>

                            <a href="/catalogo" class="btn btn-outline-secondary">
                                <span class="material-symbols-outlined">arrow_back</span>
                                Volver al catálogo
                            </a>
                        </div>

                    </div>
                </div>

                <!-- Otros productos de la misma categoria -->
                <% if (relacionados.length > 0) { %>
                    <div class="detalle-relacionados">
                        <h2 class="detalle-relacionados-titulo">Productos similares</h2>

                        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 g-3">
                            <% relacionados.forEach(function(producto) { %>
                                <%- include('../../partials/producto_card', { producto: producto }); %>
                            <% }); %>
                        </div>
                    </div>
                <% } %>

            </main>

            <%- include('../../partials/footer'); %>

        </div>
    </div>

    <%- include('../../partials/scripts'); %>
</body>

</html>
