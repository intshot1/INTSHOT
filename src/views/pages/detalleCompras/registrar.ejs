<!DOCTYPE html>
<html lang="es">

<head>
    <%- include('../../partials/head'); %>
</head>

<body>

    <div class="app-shell d-lg-flex">

        <%- include('../../partials/menu'); %>

        <div class="app-content-wrap flex-grow-1 d-flex flex-column">

            <%- include('../../partials/header'); %>

            <main class="app-main">

                <%- include('../../partials/notificaciones'); %>

                <div class="container-lg py-3">
                    <div class="card shadow-sm">
                        <div class="card-body p-4">

                            <h1 class="display-4">Agregar Producto a la Compra</h1>
                            <p class="text-muted mb-4">Seleccione la compra, el producto, la cantidad y el precio.</p>

                            <form action="/detalleCompras" method="post">

                                <div class="row g-3">

                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label class="form-label" for="compra">Compra</label>
                                            <% if (typeof compras !== "undefined") { %>
                                                <select name="compra" class="form-select" id="compra" required>
                                                    <option value="">Seleccione la compra</option>
                                                    <% compras.forEach(function(compra) { %>
                                                        <option value="<%=compra._id%>"><%=compra._id%> - <%=compra.estado%></option>
                                                    <% }); %>
                                                </select>
                                            <% } else { %>
                                                <input type="text" class="form-control" id="compra" name="compra" placeholder="Id de la compra" required>
                                            <% } %>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label class="form-label" for="producto">Producto</label>
                                            <% if (typeof productos !== "undefined") { %>
                                                <select name="producto" class="form-select" id="producto" required>
                                                    <option value="">Seleccione el producto</option>
                                                    <% productos.forEach(function(producto) { %>
                                                        <option value="<%=producto._id%>"><%=producto.nombre%> - <%=producto.talla%> - <%=producto.color%></option>
                                                    <% }); %>
                                                </select>
                                            <% } else { %>
                                                <input type="text" class="form-control" id="producto" name="producto" placeholder="Id del producto" required>
                                            <% } %>
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="mb-3">
                                            <label class="form-label" for="cantidad">Cantidad</label>
                                            <input type="number" min="1" class="form-control" id="cantidad" name="cantidad" placeholder="Cantidad" required>
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="mb-3">
                                            <label class="form-label" for="cantidad_recibida">Cantidad recibida</label>
                                            <input type="number" min="0" class="form-control" id="cantidad_recibida" name="cantidad_recibida" value="0">
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="mb-3">
                                            <label class="form-label" for="precio_unitario">Precio unitario</label>
                                            <input type="number" min="0" step="0.01" class="form-control" id="precio_unitario" name="precio_unitario" placeholder="Precio unitario" required>
                                        </div>
                                    </div>

                                    <!-- Botones -->
                                    <div class="col-12 mt-4 text-center">
                                        <button type="submit" class="btn btn-success px-5">Agregar</button>
                                        <a href="/detalleCompras" class="btn btn-outline-secondary px-5">Volver</a>
                                    </div>

                                </div>
                            </form>

                        </div>
                    </div>
                </div>

            </main>

            <%- include('../../partials/footer'); %>

        </div>
    </div>

    <%- include('../../partials/scripts'); %>
</body>

</html>
